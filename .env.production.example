# AlgoTrade Production Environment Configuration Template
# COPY TO .env IN PRODUCTION & SET STRONG KEYS

# 1. Safety & Trading Mode
LIVE_TRADING=false

# 2. Security Keys (Backend Only - DO NOT prefix with VITE_)
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=YOUR_GENERATED_64_BYTE_RANDOM_VALUE

# Generate using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=YOUR_GENERATED_FERNET_BASE64_KEY

# 3. Database & Redis Connection
DATABASE_URL=postgresql://neondb_owner:npg_2cQOu9sTZElj@ep-still-snow-axlrokz2-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require
REDIS_URL=redis://localhost:6379/0

# 4. Frontend API & WebSocket URLs (Bundled into production static build)
# Note: Use https:// and wss:// for production deployed domain
VITE_API_URL=https://algotrade-api.example.com/api/v1
VITE_WS_URL=wss://algotrade-api.example.com/ws
