# AlgoTrade System Environment Variables Configuration
# Copy this file to .env before starting services

# Safety & Trading Mode Defaults
LIVE_TRADING=false
PAPER_TRADING_DEFAULT=true

# Security Keys
SECRET_KEY=generate_a_random_jwt_secret_key_32_bytes_minimum
ENCRYPTION_KEY=generate_a_fernet_256_bit_base64_encoded_key

# Database Connection
DATABASE_URL=postgresql://algotrade:algotrade_secret_pass@localhost:5432/algotrade_db

# Redis Connection
REDIS_URL=redis://localhost:6379/0

# Angel One SmartAPI Credentials (ONLY stored server-side in encrypted database vault, NEVER expose on frontend)
ANGEL_API_KEY=your_angel_one_api_key_here
ANGEL_CLIENT_CODE=your_client_code_here
ANGEL_PIN=your_account_pin_here
ANGEL_TOTP_SECRET=your_base32_totp_secret_here

# Risk Limit System Thresholds
GLOBAL_MAX_DAILY_LOSS_INR=50000.0
GLOBAL_MAX_PORTFOLIO_DELTA=500.0
GLOBAL_KILL_SWITCH_ACTIVE=false

# WebSocket Server Port
WS_PORT=8000
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws
