# AlgoTrade Vercel Deployment Environment Variables
# Add these in the Vercel Dashboard: Project -> Settings -> Environment Variables
# (Duplicate for Production / Preview / Development as needed)

# 1. Frontend API URL (bundled at build time). Relative path routes to the
#    Vercel Serverless Function defined in api/index.py
VITE_API_URL=/api/v1
VITE_API_BASE_URL=/api/v1
# VITE_WS_URL is NOT used on Vercel - Serverless Functions do not support
# long-lived WebSockets. The frontend automatically falls back to the
# built-in simulated tick stream, so omit this variable.

# 2. Backend (runtime) variables consumed by api/index.py -> backend.main:app
DATABASE_URL=postgresql://neondb_owner:npg_2cQOu9sTZElj@ep-still-snow-axlrokz2-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require
LIVE_TRADING=false
SECRET_KEY=generate_a_random_jwt_secret_key_32_bytes_minimum
ENCRYPTION_KEY=generate_a_fernet_256_bit_base64_encoded_key

# 3. Signal Vercel runtime that we are serverless (skips background tasks)
VERCEL=1